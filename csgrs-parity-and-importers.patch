+        flat.push(c.y as f64);
+    }
+    let obj = Object::new();
+    Reflect::set(&obj, &"points".into(), &Float64Array::from(flat.as_slice())).unwrap();
+    Reflect::set(&obj, &"closed".into(), &JsValue::from_bool(closed)).unwrap();
+    out.push(&obj);
+}
