+/// Push one ring `{ points: Float64Array([x0,y0,...]), closed }` onto `out`.
+fn push_ring_2d(out: &js_sys::Array, coords: &[geo::Coord<Real>], closed: bool) {
+    let mut flat: Vec<f64> = Vec::with_capacity(coords.len() * 2);
+    for c in coords {
