{
  "name": "@archiyou/meshup",
  "version": "0.1.0",
  "description": "General purpose 3D mesh library with various modeling techniques (CSG, 2D, quasi-CAD) and target applications (3D printing, craft, CNC) in Typescript and powered by Rust (CSGRS). ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/wasm/meshup.js",
    "src/wasm/meshup_bg.wasm",
    "src/wasm/LICENSE",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:wasm": "tsx buildscripts/build-wasm.ts",
    "rust:check": "cd ./rust && cargo check --features wasm --target wasm32-unknown-unknown",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "check:wasm-integrity": "tsx buildscripts/check-wasm-integrity.ts",
    "check:pack": "tsx buildscripts/check-pack.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "3d",
    "mesh",
    "csg",
    "geometry",
    "cad",
    "wasm",
    "gltf",
    "sdf",
    "3d-printing",
    "nurbs"
  ],
  "author": "Mark van der Net (Archiyou)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchiyouApp/meshup.git"
  },
  "homepage": "https://github.com/ArchiyouApp/meshup#readme",
  "bugs": {
    "url": "https://github.com/ArchiyouApp/meshup/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@types/node": "^25.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0"
  }
}
